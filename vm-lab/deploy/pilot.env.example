# Browser RDP pilot stack
#
# The pilot runs on its own virtual machine with its own database and its own
# tunnel. It clones template 501 rather than VM 500 and it is the only
# deployment with BROWSER_RDP_ENABLED turned on.
#
# Every value below that differs from production carries the reason. Copy the
# rest from the production .env.

# --- Route namespace -------------------------------------------------------
# The lab API writes Traefik routes as lab-{session_id}.{DOMAIN}. A pilot
# sharing labsconnect.org would let two Traefik instances claim the same
# session hostnames, and the pilot could capture a production route. This is
# the single most important difference in this file.
DOMAIN=pilot.labsconnect.org
LTI_BASE_URL=https://lti.pilot.labsconnect.org
RDP_GATEWAY_URL=https://rdp.pilot.labsconnect.org
# Empty here advertises ws://<host>:8081, which is neither routed through
# Traefik nor permitted from a page served over HTTPS.
WS_PUBLIC_URL=wss://rdp.pilot.labsconnect.org/ws
# Issued for the pilot tunnel only. Deleting it removes the pilot from the
# internet without touching production DNS.
CF_TUNNEL_TOKEN=

# --- Source image ----------------------------------------------------------
# 501 rhcsa10-rdp-pilot, cloned from VM 500's base-with-reporting snapshot on
# 2026-09-18 and prepared with system-mode GNOME Remote Desktop. Production
# stays on 500.
PROXMOX_TEMPLATE_ID=501
PROXMOX_TEMPLATE_SNAPSHOT=base-with-reporting
PROXMOX_HOST=pve.pm.itdivision.org
PROXMOX_NODE=pve
PROXMOX_VLAN_TAG=225
PROXMOX_MTU=9000
MGMT_NETWORK_PREFIX=172.18.8.
VM_RAM_MB=16384
VM_VCPUS=4

# --- Browser desktop -------------------------------------------------------
# The pilot is the only deployment with this on.
BROWSER_RDP_ENABLED=true
# A GNOME Remote Desktop credential, not a system account. Deliberately not
# the kiosk account password: SSH_USER and SSH_PASSWORD authenticate the ttyd
# terminal path, so changing that account's password to serve the desktop
# would break the terminal.
RDP_USERNAME=student
LAB_RDP_PASSWORD=student
# RHEL GNOME Remote Desktop negotiates TLS. Windows images will want nla.
RDP_SECURITY=any
DESKTOP_TOKEN_TTL_SECONDS=60
# Exactly 32 bytes. The gateway refuses to start otherwise, which is intended.
GUACAMOLE_TOKEN_KEY=
GUACD_HOST=guacd
LAB_API_URL=http://lab-api:8000
HANDLE_TTL_MS=30000

# --- Secrets, all fresh for the pilot --------------------------------------
# Never reuse production values. A leaked pilot secret must not open anything
# a student depends on.
LAB_API_SERVICE_TOKEN=
SESSION_SECRET=
POSTGRES_PASSWORD=
LAB_DB_PASS=
LTI_DB_PASS=

# --- Guest login -----------------------------------------------------------
# Defaults in code are kiosk and redhat for the RHA foundation host, and
# production does not override them. The pilot image inherits the same
# accounts.
SSH_USER=kiosk

# --- Off for the pilot -----------------------------------------------------
# The Learning Record Store backfill has never been enabled anywhere and the
# pilot is not the place to switch it on.
LRS_BACKFILL_ENABLED=false
