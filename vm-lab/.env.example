# ==============================================================================
# Red Hat Academy VM Lab - Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your values
# ==============================================================================

# ------------------------------------------------------------------------------
# Domain Configuration
# ------------------------------------------------------------------------------
# Your main domain for the lab environment
DOMAIN=lab.yourdomain.com

# Full URL for the LTI server (used in LTI configurations)
LTI_BASE_URL=https://lti.yourdomain.com

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# PostgreSQL root password
POSTGRES_PASSWORD=change_this_secure_password

# Database passwords for each service
LTI_DB_PASS=change_this_lti_password
LAB_DB_PASS=change_this_lab_password

# ------------------------------------------------------------------------------
# Cloudflare Tunnel
# ------------------------------------------------------------------------------
# Get this from: cloudflared tunnel create <name>
# Or from the Cloudflare Zero Trust dashboard
CF_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# ------------------------------------------------------------------------------
# VM Configuration
# ------------------------------------------------------------------------------
# Path to the base QCOW2 image (Red Hat Academy VM)
BASE_QCOW=/var/lib/libvirt/images/rhel-academy-base.qcow2

# RAM per VM in MB (16GB = 16384)
VM_RAM_MB=16384

# vCPUs per VM
VM_VCPUS=4

# SSH username on the VM (default: kiosk for Red Hat Academy images)
SSH_USER=kiosk

# ------------------------------------------------------------------------------
# Proxmox net0 Configuration (optional)
# ------------------------------------------------------------------------------
# clone_vm() rewrites net0 on every cloned VM. By default it sets only
# "virtio,bridge=${PROXMOX_BRIDGE}", which drops any tag/mtu/firewall/etc. that
# was on the template's net0. Set these to have clone_vm() include them in the
# rewrite. Leave empty to preserve the original (untagged, default-MTU) behavior.

# VLAN tag for net0 — required when the bridge is VLAN-aware and the cloned VM
# must land on a tagged VLAN. Example: 225
PROXMOX_VLAN_TAG=

# MTU for net0 — required when the network needs jumbo frames or a non-1500
# MTU. Example: 9000
PROXMOX_MTU=

# Management network prefix used by get_vm_ip() to identify which IP on a
# multi-NIC VM is the management address. Example: 172.18.8. (trailing dot)
MGMT_NETWORK_PREFIX=

# ------------------------------------------------------------------------------
# Session Configuration
# ------------------------------------------------------------------------------
# Session secret for cookie signing (generate with: openssl rand -hex 32)
SESSION_SECRET=generate_a_secure_random_string_here

# ------------------------------------------------------------------------------
# LTI 1.1 Consumer Secrets
# ------------------------------------------------------------------------------
# Generate each with: openssl rand -hex 32
# These are shared secrets between your LMS and this tool

# Canvas LMS
LTI11_CANVAS_SECRET=generate_secure_secret_for_canvas

# Blackboard
LTI11_BLACKBOARD_SECRET=generate_secure_secret_for_blackboard

# Moodle
LTI11_MOODLE_SECRET=generate_secure_secret_for_moodle

# Brightspace (D2L)
LTI11_BRIGHTSPACE_SECRET=generate_secure_secret_for_brightspace

# Test consumer (for development only - remove in production)
LTI11_TEST_SECRET=test_secret_do_not_use_in_production
