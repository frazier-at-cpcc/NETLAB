# ==============================================================================
# Red Hat Academy VM Lab - Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your values
# ==============================================================================

# ------------------------------------------------------------------------------
# Domain Configuration
# ------------------------------------------------------------------------------
# Your main domain for the lab environment
DOMAIN=lab.yourdomain.com

# Full URL for the LTI server (used in LTI configurations)
LTI_BASE_URL=https://lti.yourdomain.com

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# PostgreSQL root password
POSTGRES_PASSWORD=change_this_secure_password

# Database passwords for each service
LTI_DB_PASS=change_this_lti_password
LAB_DB_PASS=change_this_lab_password

# ------------------------------------------------------------------------------
# Cloudflare Tunnel
# ------------------------------------------------------------------------------
# Get this from: cloudflared tunnel create <name>
# Or from the Cloudflare Zero Trust dashboard
CF_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# ------------------------------------------------------------------------------
# VM Configuration
# ------------------------------------------------------------------------------
# Path to the base QCOW2 image (Red Hat Academy VM)
BASE_QCOW=/var/lib/libvirt/images/rhel-academy-base.qcow2

# RAM per VM in MB (16GB = 16384)
VM_RAM_MB=16384

# vCPUs per VM
VM_VCPUS=4

# SSH username on the VM (default: kiosk for Red Hat Academy images)
SSH_USER=kiosk

# ------------------------------------------------------------------------------
# Proxmox net0 Configuration (optional)
# ------------------------------------------------------------------------------
# clone_vm() rewrites net0 on every cloned VM. By default it sets only
# "virtio,bridge=${PROXMOX_BRIDGE}", which drops any tag/mtu/firewall/etc. that
# was on the template's net0. Set these to have clone_vm() include them in the
# rewrite. Leave empty to preserve the original (untagged, default-MTU) behavior.

# VLAN tag for net0 — required when the bridge is VLAN-aware and the cloned VM
# must land on a tagged VLAN. Example: 225
PROXMOX_VLAN_TAG=

# MTU for net0 — required when the network needs jumbo frames or a non-1500
# MTU. Example: 9000
PROXMOX_MTU=

# Management network prefix used by get_vm_ip() to identify which IP on a
# multi-NIC VM is the management address. Example: 172.18.8. (trailing dot)
MGMT_NETWORK_PREFIX=

# ------------------------------------------------------------------------------
# Session Configuration
# ------------------------------------------------------------------------------
# Session secret for cookie signing (generate with: openssl rand -hex 32)
SESSION_SECRET=generate_a_secure_random_string_here

# ------------------------------------------------------------------------------
# Service-to-Service Authentication
# ------------------------------------------------------------------------------
# Shared secret the lti-server sends to lab-api on POST /api/cells and
# GET /api/grade-events. Generate with: openssl rand -hex 32
# If this is left unset, both routes fail closed and answer 503 rather than
# admitting unauthenticated callers.
LAB_API_SERVICE_TOKEN=generate_a_secure_random_string_here

# ------------------------------------------------------------------------------
# LRS Grade Backfill (migration aid, disabled by default)
# ------------------------------------------------------------------------------
# On first gradebook cell creation, lab-api can look up a student's prior lab
# work in the Learning Record Store and deliver it once through the ordinary
# outcome path. This exists to migrate history off the retired SCORM packages
# and is not a standing feature. See
# docs/superpowers/specs/2026-09-15-lrs-grade-backfill.md.
#
# Every variable below fails the feature off, never open. Leaving any one of
# them unset or invalid disables the whole mechanism, and lab-api logs which
# variable is missing at startup without ever printing its value.

# Master switch. Only 1, true, or yes (case-insensitive) turn the feature on.
# Any other value, including an unset variable, is off.
LRS_BACKFILL_ENABLED=false

# Base URL of the read-only xAPI endpoint on the Learning Record Store.
LRS_READ_URL=https://lrs.labsconnect.org/xapi

# HTTP Basic credential for a READ-ONLY Learning Record Store account. This
# is not the write credential the guest VM uses for the live xAPI channel,
# and it must never be granted write authority. Supply it either as the raw
# key:secret pair from the store's credential page or already base64-encoded;
# lab-api detects the raw form by the colon and encodes it. Leaving this
# unset disables the feature regardless of LRS_BACKFILL_ENABLED.
LRS_READ_AUTH=

# ISO instant cutover bound. THIS IS A SECURITY CONTROL, not a convenience
# setting. Only statements the store recorded (its own `stored` value, which
# a client cannot forge) before this instant are eligible for backfill. A
# student who extracts the LRS write credential from a guest VM can post a
# fabricated statement with any `timestamp` they like, but cannot make the
# store assign it a past `stored` value. Leaving this unset disables the
# feature regardless of LRS_BACKFILL_ENABLED. Example: 2026-10-01T00:00:00Z
LRS_BACKFILL_CUTOFF=

# Comma-separated domain equivalence list. A launch address is matched
# exactly, then against the same local part at each of these domains, so the
# secondary CPCC domain and known typo domains are recovered. A domain not on
# this list is never substituted, so an address from another institution
# sharing the same store can never satisfy a CPCC launch.
LRS_BACKFILL_DOMAINS=email.cpcc.edu,lab.cpcc.edu,email.edu.cpcc,cpcc.email.edu,cpcc.edu

# ------------------------------------------------------------------------------
# LTI 1.1 Consumer Secrets
# ------------------------------------------------------------------------------
# Generate each with: openssl rand -hex 32
# These are shared secrets between your LMS and this tool

# Canvas LMS
LTI11_CANVAS_SECRET=generate_secure_secret_for_canvas

# Blackboard
LTI11_BLACKBOARD_SECRET=generate_secure_secret_for_blackboard

# Moodle
LTI11_MOODLE_SECRET=generate_secure_secret_for_moodle

# Brightspace (D2L)
LTI11_BRIGHTSPACE_SECRET=generate_secure_secret_for_brightspace

# NetLab LTI 1.3 Broker (LabsConnect grade path). Generate with:
# openssl rand -hex 32. Set the identical value as consumer_secret on
# the broker's labsconnect provider in config/broker.example.yaml
# (netlab-lti1p3 repo), so the two systems share one secret. If left
# unset, both routes fail closed: an inbound broker launch is rejected
# as an unknown consumer, and an outbound grade callback is refused as
# unsigned, and neither error names this cause.
LTI11_LTIBROKER_SECRET=generate_secure_secret_for_ltibroker

# Test consumer (for development only - remove in production)
LTI11_TEST_SECRET=test_secret_do_not_use_in_production
